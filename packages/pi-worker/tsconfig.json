{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../contracts/generated/**/*.ts",
    "../judgement/src/**/*.ts",
    "../judgement/test/**/*.ts",
    "../formation/src/**/*.ts",
    "../formation/test/**/*.ts",
    "../activation/src/**/*.ts",
    "../activation/test/**/*.ts",
    "../consolidation/src/**/*.ts",
    "../consolidation/test/**/*.ts",
    "../maintenance/src/**/*.ts",
    "../maintenance/test/**/*.ts",
    "../cli/src/**/*.ts",
    "../cli/test/**/*.ts",
    "../supervisor/src/**/*.ts",
    "../supervisor/test/**/*.ts",
    "../../examples/**/*.ts"
  ]
}
