{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActivationWindow",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActivationCandidate"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivationCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "cutoff": {
      "type": "integer",
      "minimum": 0
    },
    "eligible": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryRef"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextGroup"
      }
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivationCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "projection_watermark": {
      "description": "Lexical updates are transactional; vectors are rechecked against domain versions.",
      "type": "integer",
      "minimum": 0
    },
    "query": {
      "$ref": "#/$defs/ActivationQuery"
    }
  },
  "required": [
    "id",
    "query",
    "cutoff",
    "projection_watermark",
    "eligible",
    "candidates",
    "groups",
    "coverage"
  ],
  "$defs": {
    "Acceptance": {
      "type": "string",
      "enum": [
        "candidate",
        "accepted",
        "withdrawn"
      ]
    },
    "ActivationCandidate": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "description": "Each prerequisite/exclusion is judged separately by J08.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory": {
          "$ref": "#/$defs/MemoryVersion"
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "memory",
        "score",
        "channels",
        "conditions"
      ]
    },
    "ActivationCursor": {
      "type": "object",
      "properties": {
        "after_id": {
          "type": "string",
          "format": "uuid"
        },
        "cutoff": {
          "type": "integer",
          "minimum": 0
        },
        "query": {
          "$ref": "#/$defs/ActivationQuery"
        }
      },
      "required": [
        "after_id",
        "cutoff",
        "query"
      ]
    },
    "ActivationQuery": {
      "type": "object",
      "properties": {
        "candidate_limit": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "context_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "exact": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "existing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fresh_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "question": {
          "type": "string"
        },
        "recorded_as_of": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scan_limit": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "task_context": {
          "description": "Task evidence supplied to semantic applicability checks, not a collection write.",
          "type": "string"
        },
        "traversal_limit": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "valid_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "vector": {
          "anyOf": [
            {
              "$ref": "#/$defs/Embedding"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "question",
        "task_context",
        "entities",
        "exact",
        "families",
        "existing",
        "scan_limit",
        "candidate_limit",
        "traversal_limit",
        "context_bytes"
      ]
    },
    "Availability": {
      "type": "string",
      "enum": [
        "routine",
        "historical",
        "retired",
        "quarantined"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sources",
        "queries",
        "tools"
      ]
    },
    "CommitPosition": {
      "type": "object",
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sequence",
        "recorded_at"
      ]
    },
    "CompletionRule": {
      "type": "object",
      "properties": {
        "confirmation_owner": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "delivery_grace_seconds": {
          "description": "When set, a host-recorded job completion before expiry can be delivered within this grace.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "equals": true,
        "required_effects": {
          "description": "Invocation IDs within the execution job. The Host supplies the operation prefix.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result_pointer": {
          "type": "string"
        },
        "semantic_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "result_pointer",
        "equals",
        "required_effects",
        "semantic_conditions"
      ]
    },
    "ConfigRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision",
        "label"
      ]
    },
    "ContextGroup": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelationVersion"
          }
        },
        "unresolved_conflict": {
          "type": "boolean"
        }
      },
      "required": [
        "members",
        "relations",
        "unresolved_conflict",
        "complete"
      ]
    },
    "Embedding": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/EmbeddingIdentity"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "identity",
        "values"
      ]
    },
    "EmbeddingIdentity": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "representation": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "revision",
        "dimensions",
        "representation"
      ]
    },
    "EvidentialStatus": {
      "type": "string",
      "enum": [
        "observation",
        "attributed_statement",
        "inference",
        "assumption",
        "simulation"
      ]
    },
    "IntentionPlan": {
      "type": "object",
      "properties": {
        "completion": {
          "$ref": "#/$defs/CompletionRule"
        },
        "execution": {
          "$ref": "#/$defs/WorkBrief"
        },
        "ready_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "ready_memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "recurrence_seconds": {
          "description": "Fixed intervals only; missed windows expire without a backlog of executions.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "trigger": {
          "$ref": "#/$defs/IntentionTrigger"
        }
      },
      "required": [
        "trigger",
        "execution",
        "ready_memories",
        "ready_artifacts",
        "completion"
      ]
    },
    "IntentionTrigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "kind": {
              "type": "string",
              "const": "time"
            }
          },
          "required": [
            "kind",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_kind": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "event"
            },
            "resource_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "resource_id",
            "event_kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after_revision": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "source_revision"
            },
            "source_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "source_id",
            "after_revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "result"
            }
          },
          "required": [
            "kind",
            "job_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "definition": {
              "$ref": "#/$defs/JudgementDefinition"
            },
            "kind": {
              "type": "string",
              "const": "semantic"
            },
            "matched_choice": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "definition",
            "matched_choice"
          ]
        }
      ]
    },
    "JudgementDefinition": {
      "type": "object",
      "properties": {
        "applicability": {
          "type": "string"
        },
        "evaluation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "permitted_uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JudgementQuestion"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "revision",
        "owner",
        "input_requirements",
        "questions",
        "applicability",
        "permitted_uses",
        "evaluation_refs",
        "fallback"
      ]
    },
    "JudgementQuestion": {
      "type": "object",
      "properties": {
        "form": {
          "$ref": "#/$defs/QuestionForm"
        },
        "instructions": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "instructions",
        "form"
      ]
    },
    "MemoryContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "corrections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "family": {
              "type": "string",
              "const": "episode"
            },
            "initial_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "objective": {
              "type": "string"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outcome": {
              "type": "string"
            },
            "uncertainty": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verification": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "family",
            "objective",
            "initial_conditions",
            "observations",
            "actions",
            "corrections",
            "outcome",
            "verification",
            "uncertainty"
          ]
        },
        {
          "type": "object",
          "properties": {
            "examined_coverage": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "family": {
              "type": "string",
              "const": "knowledge"
            },
            "predicate": {
              "type": [
                "string",
                "null"
              ]
            },
            "statement": {
              "type": "string"
            },
            "subject": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "uncertainty": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "family",
            "statement",
            "uncertainty",
            "examined_coverage"
          ]
        },
        {
          "type": "object",
          "properties": {
            "applicability": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contract": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProcedureContract"
                },
                {
                  "type": "null"
                }
              ]
            },
            "counterexamples": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MemoryRef"
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "family": {
              "type": "string",
              "const": "procedure"
            },
            "method": {
              "$ref": "#/$defs/ProcedureForm"
            },
            "purpose": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "purpose",
            "capabilities",
            "applicability",
            "exclusions",
            "method",
            "counterexamples"
          ]
        },
        {
          "type": "object",
          "properties": {
            "completion": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "family": {
              "type": "string",
              "const": "intention"
            },
            "notification_policy": {
              "type": "string"
            },
            "owner_id": {
              "type": "string",
              "format": "uuid"
            },
            "plan": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IntentionPlan"
                },
                {
                  "type": "null"
                }
              ]
            },
            "purpose": {
              "type": "string"
            },
            "readiness": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "recurrence": {
              "type": [
                "string",
                "null"
              ]
            },
            "trigger": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "purpose",
            "owner_id",
            "trigger",
            "readiness",
            "completion",
            "notification_policy"
          ]
        }
      ]
    },
    "MemoryRef": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "required": [
        "memory_id",
        "revision",
        "label"
      ]
    },
    "MemoryVersion": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "string",
          "format": "uuid"
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "record": {
          "$ref": "#/$defs/RecordDraft"
        },
        "recorded": {
          "$ref": "#/$defs/CommitPosition"
        },
        "recorded_until": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reference": {
          "$ref": "#/$defs/MemoryRef"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "reference",
        "version_id",
        "created_by",
        "recorded",
        "decision_id",
        "record"
      ]
    },
    "Origin": {
      "type": "string",
      "enum": [
        "observed",
        "activated",
        "agent_generated"
      ]
    },
    "PolicyAction": {
      "type": "string",
      "enum": [
        "retain",
        "qualify",
        "retrieve_further",
        "investigate",
        "revise",
        "defer",
        "retire",
        "request_input"
      ]
    },
    "PolicyDecision": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "policy": {
          "$ref": "#/$defs/ConfigRef"
        },
        "reason": {
          "type": "string"
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "policy",
        "action",
        "reason",
        "constraints",
        "required_evidence"
      ]
    },
    "ProcedureContract": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "recognition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecognitionCriterion"
          }
        },
        "replay_class": {
          "$ref": "#/$defs/ReplayClass"
        },
        "stopping_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "parameters",
        "effects",
        "replay_class",
        "decision_points",
        "stopping_criteria",
        "checks",
        "recognition"
      ]
    },
    "ProcedureForm": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "evidence_criteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "form": {
              "type": "string",
              "const": "advisory"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "form",
            "steps",
            "evidence_criteria"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "format": "uuid"
            },
            "entrypoint": {
              "type": "string"
            },
            "form": {
              "type": "string",
              "const": "executable"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "form",
            "artifact_id",
            "entrypoint",
            "inputs",
            "outputs"
          ]
        }
      ]
    },
    "Process": {
      "type": "string",
      "enum": [
        "formation",
        "activation",
        "consolidation",
        "maintenance",
        "investigation",
        "evaluation"
      ]
    },
    "Qualification": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "candidate"
            }
          },
          "required": [
            "status"
          ]
