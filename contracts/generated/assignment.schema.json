{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assignment",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "job": {
      "$ref": "#/$defs/Job"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "job",
    "owner_id",
    "epoch",
    "expires_at"
  ],
  "$defs": {
    "Capabilities": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sources",
        "queries",
        "tools"
      ]
    },
    "ConfigRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision",
        "label"
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "examined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexamined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "examined",
        "unexamined"
      ]
    },
    "EffectStatus": {
      "type": "string",
      "enum": [
        "confirmed",
        "not_performed",
        "unknown"
      ]
    },
    "EvidentialStatus": {
      "type": "string",
      "enum": [
        "observation",
        "attributed_statement",
        "inference",
        "assumption",
        "simulation"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Scope"
        },
        "challenging_memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "evidential_status": {
          "$ref": "#/$defs/EvidentialStatus"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "statement": {
          "type": "string"
        },
        "supporting_memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        }
      },
      "required": [
        "statement",
        "origin",
        "evidential_status",
        "sources",
        "supporting_memories",
        "challenging_memories",
        "applicability"
      ]
    },
    "Job": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "depth": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "type": "string"
        },
        "ready_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/SubmitJob"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "wait_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "state",
        "spec",
        "root_id",
        "depth",
        "attempt",
        "session_id",
        "operation_id",
        "deadline",
        "cancel_requested"
      ]
    },
    "JobState": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "running",
        "waiting",
        "completed",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "KnownEffect": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "effect_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "$ref": "#/$defs/EffectStatus"
        }
      },
      "required": [
        "effect_id",
        "status",
        "description"
      ]
    },
    "MemoryRef": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "required": [
        "memory_id",
        "revision",
        "label"
      ]
    },
    "Money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string"
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "currency",
        "minor_units"
      ]
    },
    "Origin": {
      "type": "string",
      "enum": [
        "observed",
        "activated",
        "agent_generated"
      ]
    },
    "Process": {
      "type": "string",
      "enum": [
        "formation",
        "activation",
        "consolidation",
        "maintenance",
        "investigation",
        "evaluation"
      ]
    },
    "Scope": {
      "description": "Absent dimensions are unrestricted. An assigned restriction cannot be removed\nby leaving that dimension out of a request. Tenant is checked separately.",
      "type": "object",
      "properties": {
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "entity_ids",
        "source_versions"
      ]
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "source_id",
        "revision"
      ]
    },
    "SubmitJob": {
      "type": "object",
      "properties": {
        "brief": {
          "$ref": "#/$defs/WorkBrief"
        },
        "max_attempts": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "retain_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "brief",
        "max_attempts",
        "retain_until"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/UsageStatus"
        }
      },
      "required": [
        "status"
      ]
    },
    "UsageStatus": {
      "type": "string",
      "enum": [
        "known",
        "partial",
        "unknown"
      ]
    },
    "WireVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "WorkBrief": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disclosure_policy": {
          "type": "string"
        },
        "evidence_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "frame_ref": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "freshness_requirement": {
          "type": "string"
        },
        "inputs": {
          "$ref": "#/$defs/WorkInputs"
        },
        "known_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/$defs/WorkLimits"
        },
        "output_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "$ref": "#/$defs/ConfigRef"
        },
        "process": {
          "$ref": "#/$defs/Process"
        },
        "profile": {
          "$ref": "#/$defs/ConfigRef"
        },
        "purpose": {
          "type": "string"
        },
        "retention_policy": {
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/WireVersion"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "schema_version",
        "purpose",
        "process",
        "task_id",
        "definitions",
        "scope",
        "inputs",
        "capabilities",
        "known_conflicts",
        "evidence_cutoff",
        "freshness_requirement",
        "output_criteria",
        "limits",
        "policy",
        "profile",
        "retention_policy",
        "disclosure_policy"
      ]
    },
    "WorkInputs": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      },
      "required": [
        "sources",
        "memories",
        "artifacts"
      ]
    },
    "WorkLimits": {
      "type": "object",
      "properties": {
        "max_child_concurrency": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "max_child_depth": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "max_output_bytes": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "max_provider_attempts": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        },
        "root_budget_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "root_budget_id",
        "max_provider_attempts",
        "max_tokens",
        "max_output_bytes",
        "max_child_depth",
        "max_child_concurrency"
      ]
    },
    "WorkResult": {
      "type": "object",
      "properties": {
        "child_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "examined_scope": {
          "$ref": "#/$defs/Scope"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "inputs": {
          "$ref": "#/$defs/WorkInputs"
        },
        "known_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnownEffect"
          }
        },
        "proposed_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "result_artifact": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "schema_version": {
          "$ref": "#/$defs/WireVersion"
        },
        "status": {
          "$ref": "#/$defs/WorkStatus"
        },
        "unresolved_work": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "schema_version",
        "status",
        "examined_scope",
        "inputs",
        "findings",
        "coverage",
        "unresolved_work",
        "proposed_changes",
        "child_outputs",
        "known_effects",
        "usage"
      ]
    },
    "WorkStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    }
  }
}
