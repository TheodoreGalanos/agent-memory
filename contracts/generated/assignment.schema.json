    "ScheduledInputs": {
      "description": "One typed payload per kind of trigger the scheduler can carry directly on a `WorkBrief`,\nfor data a scheduled job's handler needs but that cannot be derived from `inputs` alone and\nthat the scheduler (which holds no job fence and so cannot publish an artifact) cannot attach\nany other way.",
      "oneOf": [
        {
          "description": "A memory correction notice's propagation to its dependents: derived entirely from the\nnotice and the affected records, so the maintenance handler needs no manifest artifact.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "maintenance_correction"
            },
            "request": {
              "$ref": "#/$defs/MaintenanceRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ]
        },
        {
          "description": "A source revision's propagation to the records that depend on it.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "maintenance_source"
            },
            "request": {
              "$ref": "#/$defs/MaintenanceRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ]
        }
      ]
    },
