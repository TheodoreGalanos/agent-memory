{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assignment",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "job": {
      "$ref": "#/$defs/Job"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "job",
    "owner_id",
    "epoch",
    "expires_at"
  ],
  "$defs": {
    "Availability": {
      "type": "string",
      "enum": [
        "routine",
        "historical",
        "retired",
        "quarantined"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sources",
        "queries",
        "tools"
      ]
    },
    "CompletionRule": {
      "type": "object",
      "properties": {
        "confirmation_owner": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "delivery_grace_seconds": {
          "description": "When set, a host-recorded job completion before expiry can be delivered within this grace.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "equals": true,
        "required_effects": {
          "description": "Invocation IDs within the execution job. The Host supplies the operation prefix.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result_pointer": {
          "type": "string"
        },
        "semantic_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "result_pointer",
        "equals",
        "required_effects",
        "semantic_conditions"
      ]
    },
    "ConfigRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision",
        "label"
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "examined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexamined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "examined",
        "unexamined"
      ]
    },
    "EffectStatus": {
      "type": "string",
      "enum": [
        "confirmed",
        "not_performed",
        "unknown"
      ]
    },
    "EvidentialStatus": {
      "type": "string",
      "enum": [
        "observation",
        "attributed_statement",
        "inference",
        "assumption",
        "simulation"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Scope"
        },
        "challenging_memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "evidential_status": {
          "$ref": "#/$defs/EvidentialStatus"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "statement": {
          "type": "string"
        },
        "supporting_memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        }
      },
      "required": [
        "statement",
        "origin",
        "evidential_status",
        "sources",
        "supporting_memories",
        "challenging_memories",
        "applicability"
      ]
    },
    "IntentionPlan": {
      "type": "object",
      "properties": {
        "completion": {
          "$ref": "#/$defs/CompletionRule"
        },
        "execution": {
          "$ref": "#/$defs/WorkBrief"
        },
        "ready_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "ready_memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "recurrence_seconds": {
          "description": "Fixed intervals only; missed windows expire without a backlog of executions.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "trigger": {
          "$ref": "#/$defs/IntentionTrigger"
        }
      },
      "required": [
        "trigger",
        "execution",
        "ready_memories",
        "ready_artifacts",
        "completion"
      ]
    },
    "IntentionTrigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "kind": {
              "type": "string",
              "const": "time"
            }
          },
          "required": [
            "kind",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_kind": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "event"
            },
            "resource_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "resource_id",
            "event_kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after_revision": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "source_revision"
            },
            "source_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "source_id",
            "after_revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "result"
            }
          },
          "required": [
            "kind",
            "job_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "definition": {
              "$ref": "#/$defs/JudgementDefinition"
            },
            "kind": {
              "type": "string",
              "const": "semantic"
            },
            "matched_choice": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "definition",
            "matched_choice"
          ]
        }
      ]
    },
    "Job": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "composition": {
          "description": "Identity of the pool composition that started the current attempt, as the pool reported it.",
          "type": [
            "string",
            "null"
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "depth": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "type": "string"
        },
        "ready_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/SubmitJob"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "validation": {
          "description": "An independent output-validator's verdict on the settled result, recorded before it commits.",
          "anyOf": [
            {
              "$ref": "#/$defs/Validation"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "state",
        "spec",
        "root_id",
        "depth",
        "attempt",
        "session_id",
        "operation_id",
        "deadline",
        "cancel_requested"
      ]
    },
    "JobState": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "running",
        "waiting",
        "completed",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "JudgementDefinition": {
      "type": "object",
      "properties": {
        "applicability": {
          "type": "string"
        },
        "evaluation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "permitted_uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JudgementQuestion"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "revision",
        "owner",
        "input_requirements",
        "questions",
        "applicability",
        "permitted_uses",
        "evaluation_refs",
        "fallback"
      ]
    },
    "JudgementQuestion": {
      "type": "object",
      "properties": {
        "form": {
          "$ref": "#/$defs/QuestionForm"
        },
        "instructions": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "instructions",
        "form"
      ]
    },
    "KnownEffect": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "effect_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "$ref": "#/$defs/EffectStatus"
        }
      },
      "required": [
        "effect_id",
        "status",
        "description"
      ]
    },
    "MaintenanceRequest": {
      "type": "object",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "$ref": "#/$defs/MemoryRef"
        },
        "candidates": {
          "description": "Bounded retrieval shortlist for indirect dependencies; J16 decides relevance.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryRef"
          }
        },
        "reason": {
          "type": "string"
        },
        "removed_sources": {
          "description": "Explicit removed source snapshots; the Host verifies their unavailable state.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      },
      "required": [
        "before",
        "removed_sources",
        "candidates",
        "reason"
      ]
    },
    "MemoryContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "corrections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "family": {
              "type": "string",
              "const": "episode"
            },
            "initial_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "objective": {
              "type": "string"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outcome": {
              "type": "string"
            },
            "uncertainty": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verification": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "family",
            "objective",
            "initial_conditions",
            "observations",
            "actions",
            "corrections",
            "outcome",
            "verification",
            "uncertainty"
          ]
        },
        {
          "type": "object",
          "properties": {
            "examined_coverage": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "family": {
              "type": "string",
              "const": "knowledge"
            },
            "predicate": {
              "type": [
                "string",
                "null"
              ]
            },
            "statement": {
              "type": "string"
            },
            "subject": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "uncertainty": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "family",
            "statement",
            "uncertainty",
            "examined_coverage"
          ]
        },
        {
          "type": "object",
          "properties": {
            "applicability": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contract": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProcedureContract"
                },
                {
                  "type": "null"
                }
              ]
            },
            "counterexamples": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MemoryRef"
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "family": {
              "type": "string",
              "const": "procedure"
            },
            "method": {
              "$ref": "#/$defs/ProcedureForm"
            },
            "purpose": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "purpose",
            "capabilities",
            "applicability",
            "exclusions",
            "method",
            "counterexamples"
          ]
        },
        {
          "type": "object",
          "properties": {
            "completion": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "family": {
              "type": "string",
              "const": "intention"
            },
            "notification_policy": {
              "type": "string"
            },
            "owner_id": {
              "type": "string",
              "format": "uuid"
            },
            "plan": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IntentionPlan"
                },
                {
                  "type": "null"
                }
              ]
            },
            "purpose": {
              "type": "string"
            },
            "readiness": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "recurrence": {
              "type": [
                "string",
                "null"
              ]
            },
            "trigger": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "purpose",
            "owner_id",
            "trigger",
            "readiness",
            "completion",
            "notification_policy"
          ]
        }
      ]
    },
    "MemoryRef": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 1
        }
      },
      "required": [
        "memory_id",
        "revision",
        "label"
      ]
    },
    "Money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string"
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "currency",
        "minor_units"
      ]
    },
    "Origin": {
      "type": "string",
      "enum": [
        "observed",
        "activated",
        "agent_generated"
      ]
    },
    "PolicyAction": {
      "type": "string",
      "enum": [
        "retain",
        "qualify",
        "retrieve_further",
        "investigate",
        "revise",
        "defer",
        "retire",
        "request_input"
      ]
    },
    "PolicyDecision": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "policy": {
          "$ref": "#/$defs/ConfigRef"
        },
        "reason": {
          "type": "string"
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "policy",
        "action",
        "reason",
        "constraints",
        "required_evidence"
      ]
    },
    "ProcedureContract": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "recognition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecognitionCriterion"
          }
        },
        "replay_class": {
          "$ref": "#/$defs/ReplayClass"
        },
        "stopping_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "parameters",
        "effects",
        "replay_class",
        "decision_points",
        "stopping_criteria",
        "checks",
        "recognition"
      ]
    },
    "ProcedureForm": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "evidence_criteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "form": {
              "type": "string",
              "const": "advisory"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "form",
            "steps",
            "evidence_criteria"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "format": "uuid"
            },
            "entrypoint": {
              "type": "string"
            },
            "form": {
              "type": "string",
              "const": "executable"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "form",
            "artifact_id",
            "entrypoint",
            "inputs",
            "outputs"
          ]
        }
      ]
    },
    "Process": {
      "type": "string",
      "enum": [
        "formation",
        "activation",
        "consolidation",
        "maintenance",
        "investigation",
        "evaluation"
      ]
    },
    "Qualification": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "candidate"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evaluation_artifact": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "evaluator_profile": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ConfigRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MemoryRef"
              }
            },
            "status": {
              "type": "string",
              "const": "evaluated"
            }
          },
          "required": [
            "status",
            "conditions",
            "evidence"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "withdrawn"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "QuestionForm": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "criteria": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "required": [
            "type",
            "criteria"
          ]
        },
        {
          "type": "object",
          "properties": {
            "criteria": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "noul"
            }
          },
          "required": [
            "type",
            "criteria"
